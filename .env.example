APP_ENV=development
DATABASE_URL=sqlite:///./autonomous_company.db
# Docker/production: postgresql+psycopg://company:company@localhost:5432/company
REDIS_URL=redis://localhost:6379/0
QUEUE_MODE=direct
LLM_MODE=mock
OPENAI_API_KEY=
REAL_MONEY_ENABLED=false
BUG_BOUNTY_EXTERNAL_ACTIONS_ENABLED=false
# Required. Generate a unique random value; the API fails closed while blank.
OWNER_TOKEN=
# Optional future trusted-adapter secret (at least 32 random characters).
# TRUSTED_RECEIPT_HMAC_SECRET=
PAPER_TREASURY_CENTS=1000000
